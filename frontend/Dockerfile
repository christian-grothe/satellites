FROM node:alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_SERVER_URL
ARG VITE_SOCKET_PORT
ARG VITE_STATIC_PORT
ARG VITE_WEBSOCKET_PROTOCOL
ARG VITE_HTTP_PROTOCOL
ENV VITE_SERVER_URL=$VITE_SERVER_URL \
    VITE_SOCKET_PORT=$VITE_SOCKET_PORT \
    VITE_STATIC_PORT=$VITE_STATIC_PORT \
    VITE_WEBSOCKET_PROTOCOL=$VITE_WEBSOCKET_PROTOCOL \
    VITE_HTTP_PROTOCOL=$VITE_HTTP_PROTOCOL
RUN npm run build

FROM nginx
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/nginx.conf
